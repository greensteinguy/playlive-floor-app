# Copy this to .env.local and fill in the staging Firebase project values.
# Production Firebase project values live in CI / Vercel / Firebase Hosting environment, not in any committed file.

# Firebase web config (the shared playlive-25a17 project — a separate staging
# project was skipped; see DECISIONS.md / Action Plan task 0.4).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# When true, the app uses mock data instead of Firestore. Useful when iterating on UI without a working Firebase config.
VITE_USE_MOCK_DATA=false

# Used only when VITE_USE_MOCK_DATA=true. The role the mock user has.
# One of: manager | td | cashier | readonly. Defaults to manager.
VITE_MOCK_ROLE=manager

# When true (paired with VITE_USE_MOCK_DATA=true), the data layer connects to a
# local Firestore emulator on 127.0.0.1:8080 instead of throwing MockModeError.
# Pair with `npm run emulator` (boots the emulator with our rules loaded) and
# the `npm run seed:*` scripts. Auth stays mocked. See docs/HANDOFF.md "Verify
# a feature with emulator data" for the full runbook.
VITE_FIRESTORE_EMULATOR=false

# Venue PayID details shown by the wallet-deposit PayID wizard (task 3.6). The
# player transfers funds to this PayID from their own banking app; the cashier
# then records the received amount as a wallet deposit. DISPLAY-ONLY — the app
# never initiates or settles a transfer, it only records that one happened (SOW
# §3.4, wallet-design §2.1). Leave blank in dev; the wizard shows a "not
# configured" note and the cashier can still record the deposit.
VITE_VENUE_PAYID=
VITE_VENUE_PAYID_NAME=
