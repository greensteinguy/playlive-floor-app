# Copy this to .env.local and fill in the staging Firebase project values.
# Production Firebase project values live in CI / Vercel / Firebase Hosting environment, not in any committed file.

# Staging Firebase project (created in Phase 0 task 0.4)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# When true, the app uses mock data instead of Firestore. Useful when iterating on UI without a working Firebase config.
VITE_USE_MOCK_DATA=false

# Used only when VITE_USE_MOCK_DATA=true. The role the mock user has.
# One of: manager | td | cashier | readonly. Defaults to manager.
VITE_MOCK_ROLE=manager
