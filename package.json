{
  "name": "playlive-floor-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:rules": "firebase emulators:exec --only firestore --project demo-rules \"vitest run --config vitest.rules.config.js\"",
    "emulator": "firebase --config ./firebase.dev.json --project demo-playlive emulators:start --only firestore",
    "seed:audit": "node scripts/seed/audit-log.js",
    "seed:dedupe": "node scripts/seed/dedupe.js",
    "seed:templates": "node scripts/seed/templates.js",
    "seed:tournaments": "node scripts/seed/tournaments.js"
  },
  "dependencies": {
    "date-fns": "^4.1.0",
    "firebase": "^12.12.1",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-router-dom": "^7.14.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@firebase/rules-unit-testing": "^5.0.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.5.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "postcss": "^8.5.10",
    "tailwindcss": "^3.4.19",
    "vite": "^8.0.9",
    "vitest": "^4.1.7"
  }
}
