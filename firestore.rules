// PlayLive Floor App — Firestore security rules v1.
//
// Scope (per docs/DECISIONS.md 27 May 2026 entry):
//   ROLE-BASED ACCESS ONLY. No business-invariant enforcement (wallet >= 0,
//   ticket face-value, status transitions, etc.) — those live in the app/UI
//   layer with manager-override paths. Rules are a thin auth-and-role gate.
//
// Roles live in the Firebase Auth custom claim `role` (set by
// scripts/admin/set-role.js). Four values: manager, td, cashier, readonly.
// Any signed-in user without one of these four roles is treated as having
// no role and gets nothing.

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Role helpers ───────────────────────────────────────────────────────
    function authed() {
      return request.auth != null;
    }
    function role() {
      // request.auth.token is null-safe only inside authed(); callers must guard.
      return request.auth.token.role;
    }
    function hasRole(roles) {
      return authed() && (role() in roles);
    }

    function canRead()           { return hasRole(['manager', 'td', 'cashier', 'readonly']); }
    function isStaff()           { return hasRole(['manager', 'td', 'cashier']); }
    function isManager()         { return hasRole(['manager']); }
    function isTDorManager()     { return hasRole(['td', 'manager']); }
    function isCashierOrManager(){ return hasRole(['cashier', 'manager']); }

    // ── Player App accounts (Phase 6.2) ────────────────────────────────────
    // Players sign in with phone OTP. The linkPlayerAccount Cloud Function
    // stamps a `playerId` custom claim once the account is matched to a
    // players/{pid} doc (auto phone-match or desk-verified). These helpers
    // gate the player-self-read branch — players get their OWN data and the
    // public tournament list, nothing else.
    function isAppPlayer() {
      return authed() && 'playerId' in request.auth.token;
    }
    function isLinkedPlayer(pid) {
      return isAppPlayer() && request.auth.token.playerId == pid;
    }

    // ── Tournaments and subcollections ─────────────────────────────────────
    // TDs and Managers configure and run tournaments. Cashiers register
    // players (entries). Bounty draws and entries are written by floor staff.
    match /tournaments/{tid} {
      // Staff read everything; linked app players read non-draft tournaments
      // (the Player App visibility rule from canonical-schema.md §3.1 — its
      // queries must constrain status accordingly, e.g. where(status in [...])).
      allow read:  if canRead() || (isAppPlayer() && resource.data.status != 'draft');
      allow write: if isTDorManager();

      match /sessions/{sid} {
        allow read:  if canRead();
        allow write: if isTDorManager();
      }
      match /entries/{eid} {
        allow read:  if canRead();
        allow write: if isStaff();
      }
      match /tables/{tableId} {
        allow read:  if canRead();
        allow write: if isTDorManager();
      }
      match /bountyDraws/{drawId} {
        allow read:  if canRead();
        // TD records knockouts; cashier confirms win-credit by patching
        // walletTransactionId. Both ops happen via floor staff.
        allow write: if isStaff();
      }
    }

    // ── Players and subcollections ─────────────────────────────────────────
    // Cashiers create and edit players. Wallet writes go through the wallet
    // module (rules don't enforce that — app's job). Tickets follow the same
    // pattern: any staff member can write through the wallet module.
    match /players/{pid} {
      // Staff read all; a linked app player reads their OWN doc (and nothing
      // else — the playerId custom claim can only ever match one document).
      allow read:  if canRead() || isLinkedPlayer(pid);
      allow write: if isCashierOrManager();

      match /walletTransactions/{txId} {
        allow read:  if canRead() || isLinkedPlayer(pid);
        allow write: if isStaff();
      }
      match /tickets/{ticketId} {
        allow read:  if canRead() || isLinkedPlayer(pid);
        allow write: if isStaff();
      }
    }

    // ── Withdrawal requests ────────────────────────────────────────────────
    // Cashier creates; manager completes (atomic debit lives in the wallet
    // module). Either can cancel. Role enforcement for "complete" is at the
    // app layer because both roles legitimately write to the same doc.
    match /withdrawalRequests/{id} {
      allow read:  if canRead();
      allow write: if isCashierOrManager();
    }

    // ── Registration requests (Phase 6.2) ──────────────────────────────────
    // Created ONLY by the registerSelf Cloud Function (admin SDK — rules are
    // bypassed) when an instant wallet-paid registration can't proceed. The
    // player reads their own requests to see status; the desk reads the queue
    // and resolves (confirm creates the entry via the normal registerEntry
    // flow; the resolving update goes through staff clients).
    match /registrationRequests/{id} {
      allow read:  if canRead() || (isAppPlayer() && resource.data.playerId == request.auth.token.playerId);
      allow write: if isCashierOrManager();
    }

    // ── Account-link requests (Phase 6.2) ──────────────────────────────────
    // Created ONLY by the linkPlayerAccount Cloud Function when phone
    // auto-match fails. Desk-only: players never see these (they contain
    // phone numbers and candidate lists). Resolution goes through the
    // resolveLinkRequest callable (custom claims need the admin SDK), but
    // staff may patch notes/reject directly.
    match /linkRequests/{id} {
      allow read:  if isCashierOrManager();
      allow write: if isCashierOrManager();
    }

    // ── Templates ──────────────────────────────────────────────────────────
    match /structureTemplates/{id} {
      allow read:  if canRead();
      allow write: if isTDorManager();
    }
    match /tournamentTemplates/{id} {
      allow read:  if canRead();
      allow write: if isTDorManager();
    }

    // ── Venue settings ─────────────────────────────────────────────────────
    // Venue-wide config (chip denominations, …). Every staff screen may read it;
    // only a manager changes it.
    match /settings/{id} {
      allow read:  if canRead();
      allow write: if isManager();
    }

    // ── Named TV screens (7 Oct 2026) ──────────────────────────────────────
    // Each venue TV reads its own doc (signed in as readonly); the floor
    // (TD/manager) sets what it shows.
    match /displayScreens/{id} {
      allow read:  if canRead();
      allow write: if isTDorManager();
    }

    // ── Collection-group reads ─────────────────────────────────────────────
    // Rules v2: a nested match like /tournaments/{tid}/entries/{eid} does NOT
    // authorize collectionGroup('entries') queries — those need explicit
    // {path=**} blocks. Read-only: all writes must go through the direct
    // paths above, so no write grants here.
    match /{path=**}/entries/{eid} {
      allow read: if canRead();
    }
    match /{path=**}/tickets/{ticketId} {
      allow read: if canRead();
    }
    match /{path=**}/walletTransactions/{txId} {
      allow read: if canRead();
    }

    // ── Audit log ──────────────────────────────────────────────────────────
    // Sensitive. Only managers read (captures all overrides + manager
    // adjustments). Any floor staff can write, since every wallet operation
    // emits an audit row.
    match /auditLog/{id} {
      allow read:  if isManager();
      allow write: if isStaff();
    }

    // ── Default deny ───────────────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
